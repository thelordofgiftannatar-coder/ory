{
  "name": "skeletor-video",
  "version": "1.0.0",
  "description": "Skeletor Video - a local video and music library player",
  "main": "electron/main.cjs",
  "author": "Skeletor Video",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "@capacitor/cli": "^6.2.1"
  },
  "build": {
    "appId": "com.skeletor.video",
    "productName": "Skeletor Video",
    "directories": {
      "output": "dist"
    },
    "files": [
      "www/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "www/assets/icon.ico",
      "artifactName": "Skeletor-Video-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": true
    },
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mkv",
          "avi",
          "mov",
          "wmv",
          "webm",
          "m4v",
          "mpeg",
          "mpg",
          "ts",
          "mp3",
          "m4a",
          "wav",
          "flac",
          "ogg"
        ],
        "name": "Skeletor Video Media",
        "role": "Viewer",
        "isDefault": true
      }
    ]
  },
  "dependencies": {
    "@capacitor/core": "^6.2.1",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.2"
  }
}
